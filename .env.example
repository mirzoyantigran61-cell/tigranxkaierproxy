# ============================================================
#  TIGRAN AI V3 — Environment Variables
#  Заполнять ТОЛЬКО реальными значениями (не коммитить!)
# ============================================================

# --- APP ---
APP_VERSION=3.0
PORT=8080
SECRET_KEY=
LOG_LEVEL=INFO
FLASK_ENV=production

# --- REDIS (session store) ---
# Railway автоматически подставляет при добавлении Redis-плагина
REDIS_URL=

# --- FIREBASE ---
FIREBASE_DATABASE_URL=
# Полный JSON service account (одной строкой)
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- OPENAI ---
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.7
AI_HISTORY_LIMIT=20
AI_ENABLED=true
AI_RATE_LIMIT_PER_MIN=20

# --- PAYMENTS ---
PAYMENTS_ENABLED=true

# --- AMERIABANK (vPOS 3.0) ---
AMERIA_MERCHANT_ID=
AMERIA_USERNAME=
AMERIA_PASSWORD=
AMERIA_TERMINAL_ID=

# --- FAST BANK (WAITING FOR DOCUMENTATION) ---
FASTBANK_MERCHANT_ID=
FASTBANK_USERNAME=
FASTBANK_PASSWORD=
FASTBANK_API_KEY=
FASTBANK_SECRET=
FASTBANK_WEBHOOK_SECRET=

# --- CIS ---
CIS_MERCHANT_ID=
CIS_API_KEY=
CIS_SECRET=

# --- KAZAKHSTAN ---
KAZAKHSTAN_MERCHANT_ID=
KAZAKHSTAN_API_KEY=
KAZAKHSTAN_SECRET=

# --- PROXY ---
UPSTREAM_BASE_URL=http://127.0.0.1:9000
PROXY_VER_ADDR=
SESSION_TTL=43200
